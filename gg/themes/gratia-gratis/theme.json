{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "background": {
      "backgroundImage": true,
      "backgroundSize": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#f9f9f9" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "parchment", "name": "Parchment", "color": "#eee3c7" },
        { "slug": "olive", "name": "Olive", "color": "#62674d" },
        { "slug": "gold", "name": "Gold", "color": "#bd974d" },
        { "slug": "ink", "name": "Ink", "color": "#111111" },
        { "slug": "quiet", "name": "Quiet", "color": "#666666" }
      ]
    },
    "dimensions": {
      "minHeight": true
    },
    "position": {
      "sticky": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": []
    },
    "spacing": {
      "blockGap": true,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingScale": { "steps": 0 },
      "units": [ "px", "rem", "em", "%", "vw", "vh" ],
      "spacingSizes": [
        { "slug": "10", "name": "2XS", "size": "0.5rem" },
        { "slug": "20", "name": "XS", "size": "0.75rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "clamp(1.5rem, 3vw, 2.5rem)" },
        { "slug": "50", "name": "L", "size": "clamp(2.5rem, 5vw, 4.5rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(4rem, 9vw, 8rem)" },
        { "slug": "70", "name": "2XL", "size": "clamp(6rem, 13vw, 11rem)" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": false,
      "fontFamilies": [
        {
          "fontFamily": "Cardo, 'Iowan Old Style', Baskerville, Georgia, serif",
          "name": "Cardo",
          "slug": "serif",
          "fontFace": [
            { "fontFamily": "Cardo", "fontStyle": "normal", "fontWeight": "400", "src": [ "file:./assets/fonts/cardo-regular.ttf" ] },
            { "fontFamily": "Cardo", "fontStyle": "italic", "fontWeight": "400", "src": [ "file:./assets/fonts/cardo-italic.ttf" ] },
            { "fontFamily": "Cardo", "fontStyle": "normal", "fontWeight": "700", "src": [ "file:./assets/fonts/cardo-bold.ttf" ] }
          ]
        },
        {
          "fontFamily": "Inter, Arial, sans-serif",
          "name": "Inter",
          "slug": "sans",
          "fontFace": [
            { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400", "src": [ "file:./assets/fonts/inter-regular.ttf" ] },
            { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "500", "src": [ "file:./assets/fonts/inter-medium.ttf" ] },
            { "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "600", "src": [ "file:./assets/fonts/inter-semibold.ttf" ] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "Extra small", "size": "0.72rem" },
        { "slug": "small", "name": "Small", "size": "1rem" },
        { "slug": "medium", "name": "Body", "size": "1.125rem" },
        { "slug": "large", "name": "Lead", "size": "clamp(1.35rem, 2.3vw, 2rem)" },
        { "slug": "x-large", "name": "Heading", "size": "clamp(2.6rem, 6vw, 5.8rem)" },
        { "slug": "display", "name": "Display", "size": "clamp(4rem, 10vw, 9.5rem)" }
      ]
    },
    "blocks": {
      "core/button": {
        "border": { "radius": false },
        "color": { "custom": false },
        "typography": { "fontFamily": false }
      },
      "core/navigation": {
        "typography": { "fontFamily": false, "fontSize": false }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "var:preset|spacing|30",
        "right": "var:preset|spacing|30"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|serif",
      "fontSize": "var:preset|font-size|medium",
      "fontWeight": "400",
      "lineHeight": "1.55"
    },
    "elements": {
      "button": {
        "border": { "color": "currentColor", "radius": "0", "style": "solid", "width": "1px" },
        "color": { "background": "transparent", "text": "currentColor" },
        "spacing": { "padding": { "top": "0.9rem", "right": "1.2rem", "bottom": "0.9rem", "left": "1.2rem" } },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "0.75rem", "fontWeight": "600", "letterSpacing": "0.08em", "textTransform": "uppercase" }
      },
      "caption": {
        "color": { "text": "var:preset|color|quiet" },
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|xs" }
      },
      "heading": {
        "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "400", "letterSpacing": "-0.04em", "lineHeight": "1" }
      },
      "link": {
        "color": { "text": "currentColor" },
        ":hover": { "typography": { "textDecoration": "underline" } }
      }
    },
    "blocks": {
      "core/button": {
        "typography": { "fontFamily": "var:preset|font-family|sans" }
      },
      "core/image": {
        "border": { "radius": "24px" }
      },
      "core/navigation": {
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|xs", "fontWeight": "500", "letterSpacing": "0.08em", "textTransform": "uppercase" }
      },
      "core/post-featured-image": {
        "border": { "radius": "24px" }
      },
      "core/post-terms": {
        "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|xs", "letterSpacing": "0.06em", "textTransform": "uppercase" }
      },
      "core/post-title": {
        "typography": { "fontWeight": "400", "letterSpacing": "-0.045em", "lineHeight": "0.98" }
      },
      "core/site-title": {
        "typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "1.05rem", "fontWeight": "700" }
      }
    }
  },
  "customTemplates": [
    { "name": "page-no-title", "postTypes": [ "page" ], "title": "Page without title" }
  ],
  "templateParts": [
    { "area": "header", "name": "header", "title": "Header" },
    { "area": "footer", "name": "footer", "title": "Footer" },
    { "area": "uncategorized", "name": "newsletter", "title": "Newsletter" }
  ]
}
